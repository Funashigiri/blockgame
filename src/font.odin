Glyph :: struct {
	cell:  i32,
	width: i32,
}

Font :: struct {
	glyphs: map[rune]Glyph,
	pixels: []u8, // FONT_ATLAS_W x FONT_ATLAS_H, one byte per pixel: 255 ink, 0 empty
}

font_build :: proc(f: ^Font) {
	f.pixels = make([]u8, FONT_ATLAS_W * FONT_ATLAS_H)
	for y in 0 ..< FONT_CELL_H {
		for x in 0 ..< FONT_CELL_W {
			f.pixels[y * FONT_ATLAS_W + x] = 255
		}
	}
	for art, i in GLYPH_ART {
		cell := i32(i + 1)
		cell_x, cell_y := cell % FONT_COLUMNS * FONT_CELL_W, cell / FONT_COLUMNS * FONT_CELL_H
		rows := art.rows
		y := art.top
		width: i32 = 0
		for line in strings.split_iterator(&rows, " ") {
			width = max(width, i32(len(line)))
			for c, x in line {
				if c == '#' {
					f.pixels[(cell_y + y) * FONT_ATLAS_W + cell_x + i32(x)] = 255
				}
			}
			y += 1
		}
		f.glyphs[art.r] = {cell, width}
	}
}

font_glyph :: proc(f: ^Font, r: rune) -> (Glyph, bool) {
	if g, ok := f.glyphs[r]; ok {
		return g, true
	}
	return f.glyphs['?'], false
}

// Width in font pixels: each glyph plus one pixel of space after it, except after the last.
font_text_width :: proc(f: ^Font, text: string) -> i32 {
	width: i32 = 0
	for r in text {
		if r == ' ' {
			width += FONT_SPACE_WIDTH + 1
		} else {
			g, _ := font_glyph(f, r)
			width += g.width + 1
		}
	}
	return max(width - 1, 0)
}
