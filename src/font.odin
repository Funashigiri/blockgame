package main

import "core:strings"

// Our own pixel font in the spirit of Minecraft's: capitals 7 pixels tall, small letters 5,
// tails 2 more below the line. Every letter is drawn here by hand, Russian and Latin alike.
FONT_CELL_W      :: 8
FONT_CELL_H      :: 10
FONT_COLUMNS     :: 16
FONT_ROWS        :: 16 // 256 cells; cell 0 is solid, for drawing plain rectangles with the same texture
FONT_ATLAS_W     :: FONT_COLUMNS * FONT_CELL_W
FONT_ATLAS_H     :: FONT_ROWS * FONT_CELL_H
FONT_LINE_HEIGHT :: 10 // from one line of text to the next
FONT_CAP_HEIGHT  :: 7
FONT_SPACE_WIDTH :: 3

// rows: the glyph's pixel rows from `top` down, separated by spaces; '#' is ink.
Glyph_Art :: struct {
	r:    rune,
	top:  i32,
	rows: string,
}

